# Copy to .env.local and supply local secrets. Never commit .env.local.
DJANGO_SECRET_KEY="replace-with-a-unique-random-secret"
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=10.0.2.2,127.0.0.1,localhost
DB_NAME=pebble_db
DB_USER=pebble_user
DB_PASSWORD="replace-with-local-database-password"
DB_HOST=localhost
DB_PORT=5432
DJANGO_CORS_ALLOW_ALL_ORIGINS=true
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8000
